        "workflow": "W2",
        "logic": "Apply student checking workflow with special fee structure."
      },
      {
        "condition": "If account type is 'joint savings' and multiple owners provided",
        "workflow": "W6",
        "logic": "Trigger joint account workflow with survivorship rights."
      },
      {
        "condition": "If funding source verification fails or is pending",
        "workflow": "W7",
        "logic": "Hold account in restricted mode until funding is verified."
      },
      {
        "condition": "If initial deposit is cash and amount >= 10000",
        "workflow": "W8",
        "logic": "File CTR and process same-day account opening."
      },
      {
        "condition": "If deposit amount >= 5000 and applicant is individual",
        "workflow": "W1",
        "logic": "Apply premium savings account workflow."
      },
      {
        "condition": "If none of the above conditions are met",
        "workflow": "W1",
        "logic": "Default to standard account opening workflow."
      }
    ],
