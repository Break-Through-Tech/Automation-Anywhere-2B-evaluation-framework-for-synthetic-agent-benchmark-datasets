            "provider_id": "PROV-33445",
            "existing_patient_id": "876543",
            "self_pay": false
          },
          "expected_success_outcome": {
            "final_status": "success",
            "key_outputs": {
              "patient_record": {
                "patient_id": "876543",
                "status": "merged",
                "ehr_system": "Epic"
              },
              "appointment": {
                "appointment_id": "APPT-60101",
                "provider_id": "PROV-33445",
                "slot": {
                  "date": "2024-09-12",
                  "time": "11:30",
                  "duration": 30
                },
                "status": "scheduled"
              },
              "communication_status": {
                "message_id": "MSG-80001",
                "delivery_status": "sent",
                "timestamp": "2024-08-12T08:00:00Z"
              },
              "escalation_flag": false
            }
          },
          "success_path_differences": "Agent detects exact duplicate, merges data, schedules appointment, and sends duplicate alert to staff.",
          "milestones": [
            {
              "step": 1,
              "description": "Extract patient demographics",
              "expected_state": {
                "demographics_status": "extracted"
              }
            },
            {
              "step": 2,
              "description": "Search EHR for matching records",
